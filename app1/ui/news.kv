<NewsScreen>:
    name: 'news'

    MDBoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            title: 'Business News'
            left_action_items: [['arrow-left', lambda x: setattr(app.screen_manager, 'current', 'main')]]
            right_action_items: [['refresh', lambda x: app.news.refresh_news()]]

        ScrollView:
            MDList:
                id: news_list

                MDLabel:
                    text: 'Loading news...'
                    halign: 'center'
                    padding_y: dp(20)
